{
  "name": "stellar-allowance",
  "private": true,
  "license": "Apache-2.0",
  "description": "On-chain spending limits for AI agents that pay for API calls.",
  "scripts": {
    "install:web": "npm --prefix web install",
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "lint": "npm --prefix web run lint",
    "install:client": "npm --prefix packages/client install",
    "client:build": "npm --prefix packages/client run build",
    "client:test": "npm --prefix packages/client run test",
    "test": "npm run client:build && npm --prefix web run test",
    "setup": "npm --prefix web run setup",
    "migrate": "npm --prefix web run migrate",
    "seed-demo": "npm --prefix web run seed-demo",
    "mine": "npm --prefix web run mine --",
    "agent": "npm --prefix web run agent --",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml",
    "contracts:build": "cd contracts && stellar contract build"
  }
}
