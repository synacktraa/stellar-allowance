# Stellar Allowance — copy to .env.local, then run `npm run setup` to fill in the blanks.
#
# Everything here is Stellar testnet. Do not put a mainnet secret in this file.

# --- Supabase -------------------------------------------------------------
# Create a free project at supabase.com (no card required), then:
#   Project Settings → Data API      → Project URL and service_role key
#   Project Settings → Database      → Connection string (URI), session pooler
#
# The service role key bypasses row-level security. It is read on the server only and must
# never reach the browser, which is why it has no NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Network --------------------------------------------------------------
# Testnet defaults. USDC_SAC is the Stellar Asset Contract for Circle's testnet USDC.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# --- Contract code --------------------------------------------------------
# Already uploaded to testnet, so you do not need Rust to run this. Every allowance and every
# splitter is a cheap instance created from these hashes. Rebuild only if you change the
# contracts: `npm run contracts:build`, then upload and replace these.
ALLOWANCE_WASM_HASH=6602b224e14ba4ea365308d48bae3c5f33f7637a26db924a3fdece798c4c0f8e
SPLITTER_WASM_HASH=5120984cbd8ed746d4f7c44d797c06edfd70dfd77a458d50ad5efd4b297f1054

# --- Platform -------------------------------------------------------------
# Pays the deployment fee for every allowance and splitter. `npm run setup` creates and funds
# it. It cannot spend from any allowance it deploys — the constructor names the user as owner
# in the same transaction.
PLATFORM_ADDRESS=
PLATFORM_SECRET=
PLATFORM_FEE_BPS=1000

# --- Landing page demo ----------------------------------------------------
# Two agents that buy from the same API so the page can show both outcomes: one holding its own
# wallet, one holding only an allowance. `npm run setup` creates these; `npm run seed-demo`
# registers the API and the allowance and prints the two ids below.
#
# The three DEMO_/ALLOWANCE_ values are read when the landing page is built, not per request.
# Set them before building or the page ships without its demo.
DEMO_AGENT_ADDRESS=
DEMO_AGENT_SECRET=
WALLET_AGENT_ADDRESS=
WALLET_AGENT_SECRET=
DEMO_API_ID=
ALLOWANCE_CONTRACT_ID=

# --- Local scripts only ---------------------------------------------------
# Not needed on a deployed instance. OWNER_SECRET owns the demo allowance; USER_AGENT_SECRET
# and MY_API let `npm run mine` buy from an API you registered through the UI.
OWNER_SECRET=
USER_AGENT_SECRET=
MY_API=
