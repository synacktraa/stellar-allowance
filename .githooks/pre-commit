#!/usr/bin/env bash
#
# Fast checks only. Anything that compiles belongs in pre-push, because a commit hook that
# takes more than a moment gets bypassed with --no-verify and then guards nothing.
#
# Enable with: git config core.hooksPath .githooks

set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if grep -q '^contracts/' <<<"$staged"; then
  echo "pre-commit: contracts, cargo fmt"
  (cd contracts && cargo fmt --all -- --check) || {
    echo "pre-commit: formatting is off. Run 'cd contracts && cargo fmt --all'." >&2
    exit 1
  }
fi

# The local binary, not npx: npx spends 20 seconds resolving before it runs anything.
typecheck() {
  echo "pre-commit: $1, tsc --noEmit"
  if [ ! -x "$1/node_modules/.bin/tsc" ]; then
    echo "pre-commit: $1/node_modules is missing. Run 'cd $1 && npm install'." >&2
    exit 1
  fi
  (cd "$1" && ./node_modules/.bin/tsc --noEmit) || {
    echo "pre-commit: $1 does not type check." >&2
    exit 1
  }
}

if grep -q '^sdk/' <<<"$staged"; then
  typecheck sdk
fi

if grep -q '^demo/seller/' <<<"$staged"; then
  typecheck demo/seller
fi

exit 0
